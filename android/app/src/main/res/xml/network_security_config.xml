<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Mặc định: Chặn toàn bộ Cleartext traffic (bắt buộc HTTPS và WSS) trên Production -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Cho phép Cleartext traffic cho môi trường thử nghiệm VPS IP và Localhost -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">103.20.102.229</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
