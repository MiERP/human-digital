# Lấy API Key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_VOICE=Aoede
ENABLE_TRANSCRIPTION=true
ENABLE_AFFECTIVE_DIALOG=true
# Chế độ VAD: hybrid (khuyến nghị) | manual | server
#   hybrid = server tự bắt đầu lượt (chống ồn) + client báo kết thúc (audio_stream_end).
VAD_MODE=hybrid
VAD_START_SENSITIVITY=high
VAD_END_SENSITIVITY=low
VAD_SILENCE_DURATION_MS=700
VAD_PREFIX_PADDING_MS=200
# Ngôn ngữ cố định cho phiên
GEMINI_LANGUAGE_CODE=vi-VN
# Bỏ qua tiếng ồn/nói vãng lai (giảm dừng nhầm)
ENABLE_PROACTIVE_AUDIO=true
# Chào mở màn tự động khi kết nối (warm-up AEC)
ENABLE_GREETING=true
# Chủ động khơi chuyện khi bé im lặng (trò chuyện, không phải bài học)
ENABLE_PROACTIVE_COMPANION=true
PROACTIVE_IDLE_SECONDS=15
PROACTIVE_MAX_UNANSWERED=3
PROACTIVE_MAX_PER_SESSION=12
# Tool search trả về trong bao lâu thì thôi (giây) để bé không phải chờ im lặng
SEARCH_TIMEOUT_SECONDS=1.8
# Duy trì phiên dài (nối tiếp ngữ cảnh)
ENABLE_SESSION_RESUMPTION=true
PORT=8000
HOST=0.0.0.0
# BẮT BUỘC: đặt một khóa ngẫu nhiên dài. Các endpoint admin (cấu hình hồ sơ bé,
# export/delete dữ liệu) sẽ bị TẮT nếu giá trị rỗng hoặc vẫn là placeholder.
ADMIN_API_KEY=change_me_in_production
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ===== Encyclopedia Mode (Chế độ Bách khoa toàn thư) =====
# Google Programmable Search Engine — KHÔNG bắt buộc, dùng để nâng cao chất lượng
# kết quả search. Khi không có, backend tự fallback về Wikipedia Simple English.
#
# 1. Tạo Search Engine tại: https://programmablesearchengine.google.com/
#    - Tick "Search the entire web"
#    - Ở mục "Sites to search", thêm các domain giáo dục an toàn cho trẻ em:
#      *wikipedia.org, simple.wikipedia.org, britannica.com,
#      *kids.nationalgeographic.com, kiddle.co,
#      *duckduckgo.com, duckduckgo.com/html, bbc.co.uk
# 2. Lấy Search engine ID (cx) → điền vào GOOGLE_CSE_ID bên dưới.
# 3. Tạo API key tại: https://console.cloud.google.com/ → APIs & Services
#    → Enable "Custom Search API" → Create credentials → API key
#    → điền vào GOOGLE_CSE_KEY bên dưới.
# Free quota: 100 query/ngày. Production nên có billing hoặc dùng cache 1h của backend.
GOOGLE_CSE_ID=
GOOGLE_CSE_KEY=
